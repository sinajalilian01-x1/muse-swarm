# Function-call-only keys for each robot (comma separated). Never commit real keys.
CURATOR_KEYS=ed25519:...
PAINTER_KEYS=ed25519:...
CRITIC_KEYS=ed25519:...
SELLER_KEYS=ed25519:...
# guardian.<root>: function-call key that can only call guardian_pause (max 120 s, set by the contract)
GUARDIAN_KEYS=ed25519:...
# demo collector (holds a little testnet NEAR; buys at most 0.25 NEAR per work)
COLLECTOR_KEY=ed25519:...
# signs "driver" tokens so only the visitor who opened a job drives it
JOB_SECRET=change-me
# IPFS pinning for the artworks
PINATA_JWT=...
# Vercel Cron sends this as a Bearer token to /api/cron/cycle (daily autonomous cycle)
CRON_SECRET=change-me
# Optional: turn on real AI. Without it the robots use clearly labeled local fallbacks.
NEAR_AI_API_KEY=
# Optional overrides (defaults: museswarm.testnet accounts)
# NEXT_PUBLIC_SWARM_ROOT=museswarm.testnet
# NEXT_PUBLIC_NETWORK=testnet
